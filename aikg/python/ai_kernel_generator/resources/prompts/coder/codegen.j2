```
    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    # Triton内核
    @triton.jit
    def triton_kernel():
        pass
    def triton_host():
        args = ...
        weight = nn.ConvXXX(**args).weight.to(device)
```
